{
  "templates": [
    {
      "id": "chain",
      "name": "Justification Chain",
      "description": "Two independent sources converge on a mediating structure, which produces a grounded conclusion.",
      "nodes": [
        { "role": "source-a",   "color": "#58a6ff" },
        { "role": "source-b",   "color": "#56d364" },
        { "role": "mediator",   "color": "#d2a8ff" },
        { "role": "conclusion", "color": "#f0a500" }
      ],
      "edges": [
        { "source": "source-a", "target": "mediator",   "relation": "supports" },
        { "source": "source-b", "target": "mediator",   "relation": "supports" },
        { "source": "mediator", "target": "conclusion", "relation": "enables"  }
      ]
    },
    {
      "id": "loop",
      "name": "Feedback Loop",
      "description": "A cyclic structure where a process output feeds back to reinforce or inhibit its own trigger.",
      "nodes": [
        { "role": "trigger",     "color": "#f78166" },
        { "role": "process",     "color": "#39d0d8" },
        { "role": "output",      "color": "#e8c77a" },
        { "role": "consequence", "color": "#d2a8ff" }
      ],
      "edges": [
        { "source": "trigger",     "target": "process",     "relation": "causes"      },
        { "source": "process",     "target": "output",      "relation": "produces"    },
        { "source": "output",      "target": "consequence", "relation": "leads-to"    },
        { "source": "consequence", "target": "trigger",     "relation": "reinforces"  }
      ]
    },
    {
      "id": "hierarchy",
      "name": "Hierarchical Decomposition",
      "description": "A root concept partitions into categories, each containing specific instances or subtypes.",
      "nodes": [
        { "role": "root",        "color": "#d2a8ff" },
        { "role": "category-a",  "color": "#58a6ff" },
        { "role": "category-b",  "color": "#56d364" },
        { "role": "instance-a1", "color": "#9ecfff" },
        { "role": "instance-a2", "color": "#9ecfff" },
        { "role": "instance-b1", "color": "#7ee8a2" }
      ],
      "edges": [
        { "source": "root",       "target": "category-a",  "relation": "contains" },
        { "source": "root",       "target": "category-b",  "relation": "contains" },
        { "source": "category-a", "target": "instance-a1", "relation": "includes" },
        { "source": "category-a", "target": "instance-a2", "relation": "includes" },
        { "source": "category-b", "target": "instance-b1", "relation": "includes" }
      ]
    }
  ],
